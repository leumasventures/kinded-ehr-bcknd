# Copy to .env for local work. On Render, set these in the service's Environment tab instead.
PORT=4000

# MySQL. On Render, use a managed MySQL provider (Render has none built in) and paste its details here.
DB_HOST=https://auth-db1919.hstgr.io
DB_PORT=3306
DB_USER=u986504880_kindedEHR_db
DB_PASSWORD=ScupC8210@KindedCareEHR
DB_NAME=u986504880_kindedEHR_db
# Set to "true" if your provider requires TLS.
DB_SSL=false

# Long random string (at least 32 characters). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Your GitHub Pages address, no trailing slash. Several can be separated by commas.
CORS_ORIGINS=https://kindedcarehospital.com

# Minutes a login stays valid before the app silently renews it, and days a renewal lasts.
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
MIN_PASSWORD_LENGTH=10
# Sign-in and renewal requests allowed per address per 15 minutes. A hospital shares one public address, so keep these generous.
LOGIN_RATE_LIMIT=200
REFRESH_RATE_LIMIT=600
EMERGENCY_MINUTES=60
